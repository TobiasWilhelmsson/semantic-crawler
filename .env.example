# Bring your own API key. Choose openai, gemini, deepseek, qwen, zai, or custom.
# Named providers supply their endpoint when BASE_URL is empty.
# custom (or an unset provider) requires an explicit OpenAI-compatible BASE_URL.
SEMANTIC_LLM_PROVIDER=custom
SEMANTIC_LLM_BASE_URL=
SEMANTIC_LLM_MODEL=
SEMANTIC_LLM_API_KEY=

# OpenAI example: PROVIDER=openai, MODEL=gpt-4.1-mini, your OpenAI API key.
# Gemini example: PROVIDER=gemini, MODEL=gemini-3.8-flash, your Gemini API key.
# Budget examples: deepseek + deepseek-flash; qwen + qwen-flash;
# zai + glm-4.7-flash. Use that provider's own API key.
# Budget presets use JSON mode, local schema validation, and non-thinking mode.
# Qwen defaults to Singapore; override BASE_URL for your region/workspace.
# Leave BASE_URL empty for a preset, or set your own compatible gateway.
# See docs/providers.md for complete examples. Keep keys in this local file.

# Optional request limits.
SEMANTIC_LLM_TIMEOUT=2m
SEMANTIC_LLM_MAX_TOKENS=16384
SEMANTIC_LLM_RETRIES=1
SEMANTIC_LLM_RETRY_DELAY=5s
